{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "backstage-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "assets": { "binding": "ASSETS" },
  "kv_namespaces": [{ "binding": "SITE", "id": "00000000000000000000000000000000" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "backstage-media" }],
  "services": [{ "binding": "ADMIN", "service": "backstage-admin", "entrypoint": "AdminEntrypoint" }],
  "ratelimits": [
    { "name": "FORM_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": { "ADMIN_ORIGIN": "http://localhost:5173", "SITE_URL": "http://localhost:8787" },
  "env": {
    "production": {
      "assets": { "binding": "ASSETS" },
      "kv_namespaces": [{ "binding": "SITE", "id": "00000000000000000000000000000000" }],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "backstage-media" }],
      "services": [
        { "binding": "ADMIN", "service": "backstage-admin-production", "entrypoint": "AdminEntrypoint" }
      ],
      "ratelimits": [
        { "name": "FORM_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
      ],
      "vars": { "ADMIN_ORIGIN": "https://admin.example.com", "SITE_URL": "https://example.com" }
    }
  }
}
