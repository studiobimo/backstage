{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "backstage-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*", "!/block-thumbnails/*", "!/favicon.svg"]
  },
  "vars": { "SITE_ORIGIN": "http://localhost:5174" },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "backstage",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/backstage/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "backstage-media" }],
  "kv_namespaces": [{ "binding": "SITE", "id": "00000000000000000000000000000000" }],
  "env": {
    "production": {
      "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/*", "!/assets/*", "!/block-thumbnails/*", "!/favicon.svg"]
      },
      "vars": { "SITE_ORIGIN": "https://site.example.com" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "backstage",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../packages/backstage/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "backstage-media" }],
      "kv_namespaces": [{ "binding": "SITE", "id": "00000000000000000000000000000000" }]
    }
  }
}
