{
  "name": "@studiobimo/backstage",
  "version": "0.3.0",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/studiobimo/backstage.git",
    "directory": "packages/backstage"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted",
    "exports": {
      ".": {
        "types": "./dist/lib/index.d.ts",
        "default": "./dist/lib/index.js"
      },
      "./admin": {
        "types": "./dist/lib/admin/index.d.ts",
        "default": "./dist/lib/admin/index.js"
      },
      "./internal": {
        "types": "./dist/lib/internal/index.d.ts",
        "default": "./dist/lib/internal/index.js"
      },
      "./render": {
        "types": "./dist/lib/render/index.d.ts",
        "default": "./dist/lib/render/index.js"
      },
      "./site": {
        "types": "./dist/lib/site/index.d.ts",
        "default": "./dist/lib/site/index.js"
      },
      "./site/hono": {
        "types": "./dist/lib/site/hono/index.d.ts",
        "default": "./dist/lib/site/hono/index.js"
      }
    }
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./admin": "./src/admin/index.ts",
    "./internal": "./src/internal/index.ts",
    "./render": "./src/render/index.ts",
    "./site": "./src/site/index.ts",
    "./site/hono": "./src/site/hono/index.ts"
  },
  "files": [
    "dist",
    "migrations",
    "backstage.mk"
  ],
  "scripts": {
    "build:lib": "mkdir -p node_modules/.tmp && wrangler types node_modules/.tmp/worker-env.d.ts -c ../../apps/admin/wrangler.jsonc --env-file ../../apps/admin/.dev.vars.example && tsc -p tsconfig.build.json",
    "prepack": "NODE_ENV=production pnpm --filter backstage-admin build && rm -rf dist && mkdir dist && cp -R ../../apps/admin/dist/client dist/client && pnpm build:lib",
    "test": "vitest"
  },
  "dependencies": {
    "@tiptap/core": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/static-renderer": "^3.32.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
